# APEX GP Environment Variables
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./apex_gp.db
# For PostgreSQL in Docker: postgresql+asyncpg://apex_user:apex_password@localhost:5432/apex_gp

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
SECRET_KEY=dev-only-secret-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External Providers (Rate limited and cached)
OPENF1_BASE_URL=https://api.openf1.org/v1
ERGASST_BASE_URL=https://api.jolpi.ca/ergast/f1
